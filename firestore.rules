rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /attendance_logs/{userId} {
      // Allow users to read only their own attendance logs
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to write only to their own document
      // AND strictly enforce the time window: 21:45 - 22:15 (UTC+3)
      // which is 18:45 - 19:15 in UTC.
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && (
                     (request.time.hours() == 18 && request.time.minutes() >= 45)
                     || (request.time.hours() == 19 && request.time.minutes() <= 15)
                   );
    }

    match /mobile_event_log/{eventId} {
      // Backend service account uses Admin SDK (bypasses rules)
      // Deny all client-side access
      allow read, write: if false;
    }
  }
}
