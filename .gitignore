# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# Uploads (keep directory, ignore contents)
uploads/*
!uploads/.gitkeep

# Backend verification uploads
backend/uploads/verification_docs/**
!backend/uploads/verification_docs/.gitkeep

# LaTeX generated artifacts in docs
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.synctex*
docs/*.fls
docs/*.fdb_latexmk
docs/*.nav
docs/*.snm
docs/*.vrb
docs/testcases_*.pdf
*.zip

# Local secrets — never commit (safe for `git add .`)
/secrets/*
!/secrets/.gitkeep

# Firebase credentials if misplaced outside secrets/
*firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# Backend local env
backend/.env

# Mobile Firebase client configs (generated locally)
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist
mobile/lib/firebase_options.dart
